# Database
ERP_DB_URL=jdbc:mysql://127.0.0.1:3306/bebefish_erp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
ERP_DB_USERNAME=
ERP_DB_PASSWORD=

# Authentication lifetimes (ISO-8601 durations)
ERP_AUTH_SESSION_TTL=PT12H
ERP_AUTH_TICKET_TTL=PT60S
ERP_AUTH_OAUTH_STATE_TTL=PT5M

# Optional local/test-only emergency administrator. Ignored outside local/test profiles.
ERP_LOCAL_ADMIN_ENABLED=false
ERP_LOCAL_ADMIN_MOBILE=
ERP_LOCAL_ADMIN_PASSWORD=

# Feishu enterprise OAuth. Keep credentials blank in source control.
ERP_FEISHU_ENABLED=false
ERP_FEISHU_APP_ID=
ERP_FEISHU_APP_SECRET=
ERP_FEISHU_REDIRECT_URI=http://127.0.0.1:5173/api/auth/feishu/callback
ERP_FEISHU_ALLOWED_TENANT_KEY=
ERP_FEISHU_MOCK_ENABLED=false
# Comma-separated immutable role_id|display name pairs, for example role-id-1|仓库主管
ERP_FEISHU_BUSINESS_ROLES=

# Shipping shops (comma-separated)
ERP_SHIPPING_SHOP_NAMES=贝贝鱼淘宝旗舰店

# ANE electronic waybill (disabled until account and sender are configured)
ERP_ANE_ENABLED=false
ERP_ANE_ORDER_URL=https://opc.test.ane56.com/aneop/opwb/lb/new
ERP_ANE_CODE=
ERP_ANE_APP_KEY=
ERP_ANE_CUSTOMER_CODE=
ERP_ANE_CUSTOMER_PASS=
ERP_ANE_DICT_ID=
ERP_ANE_SENDER_NAME=
ERP_ANE_SENDER_PHONE=
ERP_ANE_SENDER_PROVINCE=
ERP_ANE_SENDER_CITY=
ERP_ANE_SENDER_COUNTY=
ERP_ANE_SENDER_ADDRESS=

# Frontend
VITE_DATA_SOURCE=real
VITE_API_BASE_URL=http://127.0.0.1:8080
